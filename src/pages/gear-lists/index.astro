---
import Layout from '../../layouts/Layout.astro';
import GearListContainer from '../../components/GearLists/GearListContainer';
import './_gear-lists.scss';

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect('/login');
}
---

<Layout title="Gear Lists | Backpack App">
  <main class="container page-gear-lists">
    <div class="header">
      <h1>Gear Lists</h1>
      <a href="/dashboard" class="back-link">← Back to Dashboard</a>
    </div>

    <p className="subtitle">Plan your trips, group your items, and track your pack weight.</p>

    <GearListContainer client:load />
  </main>
</Layout>
