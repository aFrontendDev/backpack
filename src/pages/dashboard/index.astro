---
import Layout from "../../layouts/Layout.astro";
import "./_dashboard.scss";

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect("/login");
}
---

<Layout title="Dashboard">
  <main>
    <div class="header">
      <h1>Dashboard</h1>
      <a href="/" class="back-link">← Back to Home</a>
    </div>

    <div class="user-info">
      <p>Welcome, <strong>{(user as any).username}</strong>!</p>
    </div>

    <div class="dashboard-actions">
      <a href="/inventory" class="dashboard-card-link">
        <div class="icon">🎒</div>
        <h3>Gear Inventory</h3>
        <p>Manage your gear items, weights, and wishlist.</p>
      </a>

      <a href="/gear-lists" class="dashboard-card-link">
        <div class="icon">📋</div>
        <h3>Gear Lists</h3>
        <p>Plan trips, group items, and calculate pack weights.</p>
      </a>
    </div>

    </div>
  </main>
</Layout>
